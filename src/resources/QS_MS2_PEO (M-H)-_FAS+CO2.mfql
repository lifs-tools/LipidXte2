##########################################################
# Identify PEO SPCCIES #
##########################################################
QUERYNAME = PEOCO;
	DEFINE pr = C[33..100] H[30..400] O[7] N[1] P[1]' WITH DBR = (1.5,13.5), CHG = -1;
	DEFINE FAO = 'C[15..80] H[20..150] O[6] N[1] P[1]' WITH DBR = (0.5,6.5), CHG = -1;
	DEFINE FA1 = 'C[10..40] H[20..150] O[2]' WITH DBR = (1.5,7.5), CHG = -1;
	DEFINE FACO1 ='C[10..40] H[20..100]' WITH DBR = (0.5,6.5), CHG = -1;
IDENTIFY
	pr IN MS1- AND
	FAO IN MS2- AND
	FA1 IN MS2- AND
	FACO1 IN MS2-

SUCHTHAT
	isOdd(pr.chemsc[H]) AND
	isOdd(pr.chemsc[db]*2) AND
	FA1.chemsc + FAO.chemsc == pr.chemsc + 'O1 H1' AND
	FACO1.chemsc + 'C1 O2' == FA1.chemsc
  
REPORT
	PRM = pr.mass;
	EC = pr.chemsc;
	CLASS = "PE O-" % "()";
	PRC = "%d" % "((pr.chemsc)[C] - 5)";
	PRDB = "%d" % "((pr.chemsc)[db] - 1.5)";
	PROH = "%d" % "((pr.chemsc)[O] - 7)";
	SPECIE = "PE O- %d:%d:%d" % "((pr.chemsc)[C]-5, pr.chemsc[db] - 1.5, pr.chemsc[O]-7)";

        PRERR = "%2.2f" % "(pr.errppm)";
	PRI = pr.intensity;
	FA1M = FA1.mass; 
	FA1C = "%d" % "((FA1.chemsc)[C])";
	FA1DB = "%d" % "((FA1.chemsc)[db] - 1.5)"; 
        FA1ERR = "%2.2f" % "(FA1.errppm)";
	FA1I = FA1.intensity;
	FACO1M = FACO1.mass;
	FACO1I = FACO1.intensity;
	;
 
################ end script ##################

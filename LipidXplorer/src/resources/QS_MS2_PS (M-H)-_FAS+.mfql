QUERYNAME = PSFAS;
	DEFINE pr = 'C[31..80] H[40..400] N[1] O[10] P[1]' WITH DBR = (3.5, 15.5), CHG = -1;
	DEFINE FA1 = 'C[10..40] H[20..100] O[2]' WITH DBR = (1.5,7.5), CHG = -1;
	DEFINE FA2 ='C[10..40] H[20..100] O[2]' WITH DBR = (1.5,7.5), CHG = -1;
IDENTIFY
	pr IN MS1- AND
	FA1 IN MS2- AND
	FA2 IN MS2-
SUCHTHAT
	isOdd(pr.chemsc[H]) AND
	isOdd(pr.chemsc[db]*2) AND
	FA1.chemsc + FA2.chemsc + 'C6 H11 O6 N1 P1' == pr.chemsc
REPORT
	PRM = pr.mass;
	EC = pr.chemsc;
	CLASS = "PS" % "()";
	PRC = "%d" % "((pr.chemsc)[C] - 6)";
	PRDB = "%d" % "((pr.chemsc)[db] - 3.5)";
	PROH = "%d" % "((pr.chemsc)[O] - 10)";
	SPECIE = "PS %d:%d:%d" % "((pr.chemsc)[C]-6, pr.chemsc[db] - 3.5, pr.chemsc[O]-10)";
        PRERR = "%2.2f" % "(pr.errppm)";
	PRI = pr.intensity;

	FA1M = FA2.mass; 
	FA1C = "%d" % "((FA2.chemsc)[C])";
	FA1DB = "%d" % "((FA2.chemsc)[db] - 1.5)"; 
        FA1ERR = "%2.2f" % "(FA2.errppm)";
	FA1I = FA2.intensity;

	FA2M = FA1.mass; 
	FA2C = "%d" % "((FA1.chemsc)[C])";
	FA2DB = "%d" % "((FA1.chemsc)[db] - 1.5)"; 
        FA2ERR = "%2.2f" % "(FA1.errppm)";
	FA2I = FA1.intensity;
	; 

 

################ end script ##################

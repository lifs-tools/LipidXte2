########################################################### Identify PCO SPCCIES ###########################################################QUERYNAME = PCOCO;	DEFINE pr = 'C[41..53] H[77..400] N[1] O[9] P[1]' WITH DBR = (1.5,15.5), CHG = -1;	DEFINE FAO ='C[15..40] H[20..180] O[6] N[1] P[1]' WITH DBR = (0.5,7.5), CHG = -1;	DEFINE FA1 ='C[10..40] H[20..150] O[2]' WITH DBR = (1.5,7.5), CHG = -1;IDENTIFY	pr IN MS1- AND	FAO IN MS2- AND	FA1 IN MS2-SUCHTHAT	isOdd(pr.chemsc[H]) AND	isOdd(pr.chemsc[db]*2) AND	FA1.chemsc + FAO.chemsc + 'C2 H3 O1' == pr.chemsc  REPORT	PRM = pr.mass;	EC = pr.chemsc;	CLASS = "PC O-" % "()";	PRC = "%d" % "((pr.chemsc)[C] - 9)";	PRDB = "%d" % "((pr.chemsc)[db] - 1.5)";	PROH = "%d" % "((pr.chemsc)[O] - 9)";	SPECIE = "PC O- %d:%d:%d" % "((pr.chemsc)[C]-9, pr.chemsc[db] - 1.5, pr.chemsc[O]-9)";        PRERR = "%2.2f" % "(pr.errppm)";	PRI = pr.intensity;	FA1M = FA1.mass; 	FA1C = "%d" % "((FA1.chemsc)[C])";	FA1DB = "%d" % "((FA1.chemsc)[db] - 1.5)";         FA1ERR = "%2.2f" % "(FA1.errppm)";	FA1I = FA1.intensity;	; ################ end script ##################
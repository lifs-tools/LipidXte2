<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="description" content="Quantitative Fragmentation Model for Bottom-Up Shotgun Lipidomics. The LipidXte web application provides automatic correcti
    on for lipid HCD MS/MS spectra from Orbitrap instruments and is dedicated to supporting accurate quantification of molecular lipid species. The application is
    specifically designed to support easy access to established correction functions with minimum interference requirements. Keywords: shotgun, lipidomics, quantif
    ication, high-resolution, Orbitrap, mass spectrometry, HCD, CID, fragmentation, MS/MS, bottom-up, model, correction, intensity prediction, polyunsaturated, lip
    ids, glycerophospholipids, molecular species, isomers, fatty acids, carboxylate anions, analysis, software, LipidXte, LipidXplorer" />
    <meta name="googlebot" content="index, follow" />
    <meta name="google-site-verification" content="kgNHUwVqnriaWbgskssqWmF8WkSUXWIQg5hk0ok42Y0" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

      <title>LipidXte - Quantitative Fragmentation Model for Bottom-Up Shotgun Lipidomics</title>
    <% if (htmlWebpackPlugin.options.nodeModules) { %>
      <!-- Add `node_modules/` to global paths so `require` works properly in development -->
      <script>
        require('module').globalPaths.push('<%= htmlWebpackPlugin.options.nodeModules.replace(/\\/g, '\\\\') %>')
      </script>
    <% } %>
  </head>
  <body>
    <div id="app"></div>

    <% if (!htmlWebpackPlugin.options.isWeb) { %>
        <!-- Set `__static` path to static files in production electron application -->
        <script>
          if (process.env.NODE_ENV !== 'development') window.__static = require('path').join(__dirname, '/static').replace(/\\/g, '\\\\')
        </script>
        <!-- webpack builds are automatically injected -->
    <% } %>

    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XTMCE3CTJ8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-XTMCE3CTJ8');
    </script>
  </body>
</html>

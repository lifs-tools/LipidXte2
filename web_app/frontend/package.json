{
  "name": "LipidXte",
  "version": "0.0.1",
  "description": "LipidXte Web and Electron Interfaces",
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "node .electron-vue/build.js && electron-builder",
    "build:dir": "node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=clean node .electron-vue/build.js",
    "build:web": "cross-env BUILD_TARGET=web node .electron-vue/build.js && cd dist/web && rsync -arvP --del * ../../../LipidXteServer/web/",
    "dev": "node .electron-vue/dev-runner.js",
    "e2e": "npm run pack && mocha test/e2e",
    "lint": "cross-env NODE_OPTIONS=--trace-warnings eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "cross-env NODE_OPTIONS=--trace-warnings eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.renderer.config.js",
    "test": "npm run unit && npm run e2e",
    "unit": "karma start test/unit/karma.conf.js",
    "postinstall": "npm run lint:fix"
  },
  "build": {
    "productName": "project",
    "appId": "org.simulatedgreg.electron-vue",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.1",
    "axios": "^1.6.8",
    "d3-dsv": "^1.0.8",
    "electron-log": "^2.2.17",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "font-awesome": "^4.7.0",
    "lodash": "^4.17.21",
    "plotly.js": "~1.58.5",
    "regression": "^2.0.1",
    "tinycolor2": "~1.4.1",
    "vue": "^2.7.16",
    "vue-electron": "^1.0.6",
    "vue-input-tag": "0.0.16",
    "vue-router": "^3.6.5",
    "vue2-dropzone": "^3.0.3",
    "vuex": "^2.3.1"
  },
  "devDependencies": {
    "babel-core": "^6.26.3",
    "babel-eslint": "^8.2.3",
    "babel-loader": "^7.1.5",
    "babel-minify-webpack-plugin": "^0.3.1",
    "babel-plugin-istanbul": "^4.1.6",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-env": "^1.7.0",
    "babel-preset-stage-0": "^6.24.1",
    "babel-preset-vue": "^2.0.2",
    "babel-register": "^6.26.0",
    "babili-webpack-plugin": "^0.1.2",
    "bootstrap-vue": "^1.3.0",
    "cfonts": "^1.1.3",
    "chai": "^4.0.0",
    "chalk": "^1.1.3",
    "cookie-parser": "^1.4.3",
    "copy-webpack-plugin": "4.6.0",
    "cross-env": "^5.0.0",
    "css-loader": "^6.10.0",
    "del": "^2.2.1",
    "devtron": "^1.1.0",
    "electron": "^30.0.6",
    "electron-builder": "^24.9.1",
    "electron-debug": "^3.2.0",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^4.19.1",
    "eslint-config-standard": "^10.2.1",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-import-resolver-webpack": "^0.10.0",
    "eslint-loader": "^2.2.1",
    "eslint-plugin-html": "^4.0.6",
    "eslint-plugin-import": "^2.3.0",
    "eslint-plugin-node": "^4.2.2",
    "eslint-plugin-promise": "^3.4.0",
    "eslint-plugin-standard": "^3.0.1",
    "eslint-plugin-vue": "^4.7.1",
    "extract-text-webpack-plugin": "^4.0.0-beta.0",
    "file-loader": "^1.1.11",
    "html-webpack-plugin": "^5.6.0",
    "ify-loader": "^1.1.0",
    "inject-loader": "^4.0.1",
    "jade": "^1.11.0",
    "json-loader": "^0.5.7",
    "mini-css-extract-plugin": "^2.7.7",
    "mocha": "^10.4.0",
    "morgan": "^1.10.0",
    "multispinner": "^0.2.1",
    "require-dir": "^0.3.0",
    "serve-favicon": "^2.5.0",
    "style-loader": "^0.21.0",
    "url-loader": "^1.0.1",
    "vue-devtools": "^5.1.4",
    "vue-html-loader": "^1.2.4",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.5.17",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.5",
    "webpack-hot-middleware": "^2.26.0",
    "webpack-merge": "^5.10.0"
  },
  "packageManager": "yarn@4.2.2"
}
